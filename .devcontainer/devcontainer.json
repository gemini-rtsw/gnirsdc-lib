{
    "name": "Gemini GNIRS Development Container",
    "image": "registry.gitlab.com/nsf-noirlab/gemini/rtsw/iocs/gnirsdc-lib/gnirsdc-lib-env",
    "runArgs": [
        "-v", "${env:HOME}/.ssh:/root/.ssh:ro"
    ],      
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash"
            },
            "extensions": [
                "ms-python.python",
                "ms-vscode.cpptools"
            ]
          
        }
    },
    "forwardPorts": [],
    "postCreateCommand": "echo 'Container ready!'"
}
